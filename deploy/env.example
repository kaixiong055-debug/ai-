GAME_ADMIN_USERNAME=admin
# Replace this placeholder with your own strong password before starting.
GAME_ADMIN_PASSWORD=CHANGE_ME_BEFORE_STARTING
CMS_DATA_DIR=/www/wwwroot/game-cms/data
PORT=8080
SERVER_ADDRESS=127.0.0.1
COOKIE_SECURE=true
CMS_DEMO_ENABLED=false
